# Generierte und verschlüsselte Dateien prüft der Lint nicht: ihr Format
# bestimmen Terraform, die k3s-Rolle und sops, nicht wir.
---
exclude_paths:
  - ansible/kubeconfig-generated.yaml
  - ansible/kubeconfig.sops.yaml
  - ansible/app-credentials.sops.yaml
  - ansible/inventory/generated-inventory.yml
