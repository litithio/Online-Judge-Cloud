# Wird von direnv beim Betreten des Repos geladen; einmalig freigeben mit:
#   direnv allow
# Ohne direnv stattdessen in jeder neuen Shell: source .envrc

# kubectl und helm zeigen auf den Cluster, den ansible/deploy.yaml gebaut hat.
# Die Datei schreibt die k3s-Rolle auf dem Rechner, der das Play fährt. Alle
# anderen holen sie aus dem Repo, verschlüsselt liegt sie dort (#77):
#   sops -d ansible/kubeconfig.sops.yaml > ansible/kubeconfig-generated.yaml
#   chmod 600 ansible/kubeconfig-generated.yaml
export KUBECONFIG="$PWD/ansible/kubeconfig-generated.yaml"

# Die DNS-Zone des Clusters kommt aus ansible/vars/dns.yaml, damit sie an
# genau einer Stelle gepflegt wird.
export JUDGE_ZONE="$(awk '/^rfc2136_zone:/ {print $2}' "$PWD/ansible/vars/dns.yaml" 2>/dev/null)"

# Der private age-Schlüssel, mit dem sops die *.sops.yaml entschlüsselt. Unter
# Linux ist das der Standardpfad von sops, unter macOS sucht sops ohne die
# Variable unter ~/Library/Application Support, mit ihr gilt überall derselbe
# Ort. Erzeugen mit: age-keygen -o ~/.config/sops/age/keys.txt
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
