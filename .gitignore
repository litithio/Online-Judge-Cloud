# Terraform
# State enthält Zugangsdaten im Klartext und gehört nie ins Repo.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
*.auto.tfvars
crash.log

# OpenStack-Zugangsdaten
clouds.yaml
*-openrc.sh

# Ansible
*.retry
# Von der Rolle geschrieben, enthält die Cluster-Zugangsdaten im Klartext.
# Verschlüsselt liegt sie als ansible/kubeconfig.sops.yaml im Repo (#77), die
# Passwörter und der TSIG-Key ebenso in ansible/app-credentials.sops.yaml.
ansible/kubeconfig-generated.yaml
# Eine Klartextkopie der Vorlage unter diesem Namen bleibt draußen, ins Repo
# gehört nur die in place verschlüsselte .sops.yaml.
ansible/app-credentials.yaml
# Die lokalen Dateien von vor #77 liegen in älteren Arbeitsverzeichnissen noch
# mit echten Werten, ohne diese Zeilen nähme git add -A sie mit.
ansible/dns-credentials.yaml
ansible/auth-credentials.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Kubernetes
kubeconfig
*.kubeconfig

# System
.DS_Store
