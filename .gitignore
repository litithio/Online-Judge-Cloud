# Terraform
# State enthält Zugangsdaten im Klartext und gehört nie ins Repo.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
*.auto.tfvars
crash.log

# OpenStack-Zugangsdaten
clouds.yaml
*-openrc.sh

# Ansible
*.retry
# Von Terraform erzeugt, enthält die IPs eines konkreten Deployments.
ansible/inventory/generated-inventory.yml
# Enthält den TSIG-Key der eigenen DNS-Zone; Vorlage ist die .example-Datei.
ansible/dns-credentials.yaml
# Enthält die Auth-Secrets (Keycloak, OIDC-Plugin, Test-Benutzer); Vorlage ist
# die .example-Datei.
ansible/auth-credentials.yaml
# Von der Rolle geschrieben, enthält die Cluster-Zugangsdaten.
ansible/kubeconfig-generated.yaml
# Enthält das echte MongoDB-Passwort; Vorlage ist die .example-Datei.
ansible/files/mongodb-password.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Kubernetes
kubeconfig
*.kubeconfig

# System
.DS_Store
