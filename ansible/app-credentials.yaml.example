# Vorlage für ansible/app-credentials.sops.yaml, die verschlüsselt im Repo
# liegt (#77). Neu anlegen nur, wenn kein Mitglied mehr entschlüsseln kann:
# als app-credentials.sops.yaml kopieren, Werte eintragen, dann
#   sops -e -i ansible/app-credentials.sops.yaml
# In place, weil sops den Dateinamen gegen .sops.yaml prüft. Die Plays laden
# die Datei über community.sops.load_vars, die Werte gelten global im Play.

---
# Bootstrap-Admin von Keycloak. Nur für die erste Anmeldung an der
# Admin-Konsole; der Realm selbst kommt als Code (templates/keycloak-realm.json.j2).
keycloak_admin_password: "aendern-admin"

# Muss mit dem client secret im Realm-Import übereinstimmen; beide Stellen
# lesen dieselbe Variable, deshalb genügt es, sie hier zu setzen.
oidc_client_secret: "aendern-client-secret"

# Verschlüsselt das Session-Cookie des Traefik-OIDC-Plugins. Muss genau 32
# Zeichen lang sein, sonst weist das Plugin die Konfiguration ab. Erzeugen mit:
#   openssl rand -base64 32 | head -c 32
oidc_plugin_secret: "aendern-32-zeichen-plugin-secret"

# Setzt das Gateway als X-Gateway-Auth an jede Anfrage, die es weiterreicht,
# und die API vergleicht ihn (app/backend/auth.py). Damit erkennt sie einen
# direkten Aufruf des backend-Service, der die Identitäts-Header selbst setzt.
# Mindestens 32 Zeichen, die API lehnt kürzere und den Platzhalter hier beim
# Start ab. Erzeugen mit `openssl rand -base64 32`.
gateway_secret: "aendern-gateway-secret"

# Der Test-Benutzer wird beim Realm-Import angelegt (Punkt 4 der Abnahme).
# email_verified ist im Import gesetzt, damit die Anmeldung ohne Mailversand
# durchläuft.
test_user_username: "student"
test_user_password: "aendern-student"
test_user_email: "student@judge.example"

# Dozentenkonto mit der Realm-Rolle dozent, ebenfalls aus dem Realm-Import.
# Die Rolle schaltet die Verwaltung frei (#240), ein Konto ohne sie ist ein
# Student.
dozent_user_username: "dozent"
dozent_user_password: "aendern-dozent"
dozent_user_email: "dozent@judge.example"

# Viewer-Konto für den lesenden kubectl-Zugriff auf den Cluster. Mitglied der
# Gruppe cluster-viewer (vars/auth.yaml), die das ClusterRoleBinding an die
# ClusterRole view bindet. Konto und Gruppe liegen zentral in Keycloak, eine
# Sperrung dort wirkt auf allen Clustern beim nächsten Login (ein schon
# ausgestelltes Token gilt bis zu seinem Ablauf weiter).
viewer_user_username: "viewer"
viewer_user_password: "aendern-viewer"
viewer_user_email: "viewer@judge.example"

# Anmeldung an Grafana unter grafana_host. Ohne diesen Wert erzeugt der Chart
# beim ersten Ausrollen ein zufälliges Passwort, das man aus dem Secret lesen
# müsste. Der Benutzer heißt admin.
grafana_admin_password: "aendern-grafana"

# TSIG-Secret der DNS-Zone aus ansible/vars/dns.yaml, von
# https://self-service.dhbw.cloud. Die k3s-Rolle legt daraus das Secret für
# cert-manager und external-dns an.
rfc2136_tsig_secret_value: "aendern-tsig"

# Ein Benutzer je Dienst an MongoDB (#61), der Operator legt sie aus diesen
# Secrets an. Beliebige Werte, Anführungszeichen stehen lassen, sonst kann
# YAML Sonderzeichen im Passwort falsch interpretieren.
mongodb_backend_password: "aendern-backend"
mongodb_worker_password: "aendern-worker"
mongodb_durchlauf_password: "aendern-durchlauf"
mongodb_loader_password: "aendern-loader"

# Das requirepass von Valkey (#61), ein einziges Passwort für den ganzen
# Dienst. Die URI leitet ansible/tasks/valkey.yaml daraus ab.
valkey_password: "aendern-valkey"
