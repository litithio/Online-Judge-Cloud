# Kopie als dns-credentials.yaml anlegen (bleibt lokal, .gitignore) und die
# eigenen Werte von https://self-service.dhbw.cloud eintragen.
# Zonenname nach Gruppenkonvention: Subzone judge unterhalb der eigenen
# Basiszone, samt TSIG-Key genau dieser Subzone.
all:
  children:
    judge_k3s_server:
      vars:
        cert_manager_email: vorname.nachname@example.com
        rfc2136_zone: judge.<kennung>-at-cas-dhbw-de.users.dhbw.site
        rfc2136_tsig_secret_value: <TSIG-Secret>
        rfc2136_tsig_secret_alg: hmac-sha512
        rfc2136_tsig_secret_keyname: <TSIG-Keyname>
        kubeconfig_path: kubeconfig-generated.yaml
