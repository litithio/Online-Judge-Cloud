{
  "title": "Judge unter Last",
  "uid": "judge-last",
  "tags": ["online-judge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datenquelle",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Worker-Replicas",
      "description": "Wie viele Judge-Worker KEDA angefordert hat und wie viele davon bereit sind. Die Kurve zeigt die Wirkung der Last.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_spec_replicas{namespace=\"default\", deployment=\"code-worker-python\"}",
          "legendFormat": "angefordert"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"default\", deployment=\"code-worker-python\"}",
          "legendFormat": "bereit"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Länge der Warteschlange",
      "description": "Wie viele Einreichungen in judge:python liegen. KEDA skaliert an diesem Wert, ein Worker je fünf Einträge.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keda_scaler_metrics_value",
          "legendFormat": "{{scaledObject}}"
        }
      ]
    }
  ]
}
