# Kopie als mongodb-password.yaml anlegen (bleibt lokal, .gitignore) und
# ein eigenes beliebiges Passwort eintragen (oder belassen).
# Anführungszeichen dabei stehen lassen,
# sonst kann YAML Sonderzeichen im Passwort falsch interpretieren.
apiVersion: v1
kind: List
items:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: mongodb-backend-password
      namespace: "{{ app_namespace }}"
    type: Opaque
    stringData:
      password: "replace_me_backend"
  - apiVersion: v1
    kind: Secret
    metadata:
      name: mongodb-worker-password
      namespace: "{{ app_namespace }}"
    type: Opaque
    stringData:
      password: "replace_me_worker"
  - apiVersion: v1
    kind: Secret
    metadata:
      name: mongodb-durchlauf-password
      namespace: "{{ app_namespace }}"
    type: Opaque
    stringData:
      password: "replace_me_durchlauf"
  - apiVersion: v1
    kind: Secret
    metadata:
      name: mongodb-loader-password
      namespace: "{{ app_namespace }}"
    type: Opaque
    stringData:
      password: "replace_me_loader"
