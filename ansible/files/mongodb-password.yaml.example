# Kopie als mongodb-password.yaml anlegen (bleibt lokal, .gitignore) und
# ein eigenes beliebiges Passwort eintragen (oder belassen).
# Anführungszeichen dabei stehen lassen,
# sonst kann YAML Sonderzeichen im Passwort falsch interpretieren.
apiVersion: v1
kind: Secret
metadata:
  name: mongodb-app-password
  namespace: "{{ app_namespace }}"
type: Opaque
stringData:
  password: "replace_me"
