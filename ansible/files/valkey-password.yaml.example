# Kopie als valkey-password.yaml anlegen (bleibt lokal, .gitignore) und
# ein eigenes beliebiges Passwort eintragen (oder belassen).
# Anführungszeichen dabei stehen lassen,
# sonst kann YAML Sonderzeichen im Passwort falsch interpretieren.
#
# Ein Passwort für den ganzen Dienst, kein Benutzer je Dienst wie bei
# MongoDB: Valkey kennt mit requirepass nur ein einziges Passwort, nicht
# mehrere Benutzer mit eigenen Rechten.
apiVersion: v1
kind: Secret
metadata:
  name: valkey-app-password
  namespace: "{{ app_namespace }}"
type: Opaque
stringData:
  password: "replace_me"
  connectionString: "redis://:replace_me@valkey:6379"
