{
  "title": "Editierdistanz",
  "description": "Bestimme die kleinste Zahl an Einfügungen, Löschungen und Ersetzungen, mit der das erste Wort in das zweite übergeht.",
  "input_format": "Zwei Zeilen mit je einem Wort.",
  "output_format": "Die kleinste Zahl an Schritten als ganze Zahl.",
  "difficulty": "schwer",
  "time_limit_seconds": 4,
  "memory_limit_mb": 64,
  "test_cases": [
    {
      "name": "kitten zu sitting",
      "sample": true,
      "input": "kitten\nsitting\n",
      "expected_output": "3"
    },
    {
      "name": "Gleiche Wörter",
      "input": "abc\nabc\n",
      "expected_output": "0"
    },
    {
      "name": "Lange Wörter",
      "input": "\\n",
      "expected_output": "2"
    }
  ]
}
