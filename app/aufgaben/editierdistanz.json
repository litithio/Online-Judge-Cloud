{
  "title": "Editierdistanz",
  "description": "Lies zwei Wörter, jedes in einer eigenen Zeile, und gib die kleinste Zahl an Einfügungen, Löschungen und Ersetzungen aus, mit der das erste Wort in das zweite übergeht.",
  "test_cases": [
    {
      "input": "kitten\nsitting\n",
      "expected_output": "3"
    },
    {
      "input": "abc\nabc\n",
      "expected_output": "0"
    },
    {
      "input": "\\n",
      "expected_output": "2"
    }
  ]
}
