{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "online-judge values",
  "description": "Prüft die values bei install und upgrade. Fehlt ein Pflichtfeld, bricht Helm sofort mit klarer Meldung ab, statt still mit einem falschen Bild zu deployen.",
  "type": "object",
  "required": [
    "image",
    "externe",
    "judge"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "registry",
        "tag"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "Image-Tag der eigenen Dienste. Bewusst ohne Vorgabe, damit ein vergessener Tag hier auffällt statt still auf latest zu fallen."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "externe": {
      "type": "object",
      "required": [
        "mongoSecret",
        "redisUri",
        "redisKedaAdresse"
      ],
      "description": "Anbindung der vorhandenen Datendienste. Das Chart legt sie nicht an, es verbindet sich nur.",
      "properties": {
        "mongoSecret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "description": "Operator-Secret mit der MongoDB-URI samt Zugangsdaten.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "redisUri": {
          "type": "string",
          "minLength": 1
        },
        "redisKedaAdresse": {
          "type": "string",
          "minLength": 1,
          "description": "Queue als host:port mit vollem DNS-Namen. Der KEDA-Operator läuft in einem anderen Namespace, ein kurzer Name würde dort aufgelöst."
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "judge": {
      "type": "object",
      "required": [
        "runtimeClass",
        "tmpSizeLimit",
        "sprachen",
        "durchlauf",
        "heartbeatFrist"
      ],
      "description": "Worker, ScaledObject und Rückhol-CronJob. Der Seed der Aufgaben läuft aus Ansible.",
      "properties": {
        "runtimeClass": {
          "type": "string",
          "minLength": 1
        },
        "tmpSizeLimit": {
          "type": "string",
          "pattern": "^([0-9]*[1-9][0-9]*(\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)(Ki|Mi|Gi|Ti|k|M|G|T)?$",
          "description": "Deckel für das /tmp der Worker (emptyDir sizeLimit). Ohne ihn stünde das emptyDir offen, deshalb Pflicht. Das Muster verlangt eine positive Zahl mit optionaler Einheit, eine 0 würde kubelet als Limit ignorieren und beliebiger Text fiele erst am API-Server auf. Die Exponentenschreibweise von Kubernetes-Quantities bleibt bewusst draußen."
        },
        "sprachen": {
          "type": "array",
          "minItems": 1,
          "description": "Je Eintrag ein Worker-Deployment und ein ScaledObject. Leer wäre ein Judge ohne Worker, deshalb minItems 1.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "repository",
              "resources",
              "keda"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "resources": {
                "type": "object"
              },
              "keda": {
                "type": "object",
                "required": [
                  "min",
                  "max",
                  "listLength",
                  "activationListLength"
                ],
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "listLength": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "activationListLength": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "durchlauf": {
          "type": "object",
          "required": [
            "repository",
            "schedule",
            "maxVersuche",
            "resources"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "maxVersuche": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "heartbeatFrist": {
          "type": "integer",
          "minimum": 63,
          "description": "Alter in Sekunden, ab dem der Heartbeat eines Workers als zu alt gilt. Das Minimum von 63 ist die berechenbare Untergrenze aus worker.py, ein Sandbox-Lauf endet nach GRENZE_ZEIT_MAX + 1 + ZEITFRIST_PUFFER und danach wartet REST_FRIST auf das Aufräumen. Darunter tötet die Probe einen Worker mitten in einem Testfall."
        }
      }
    }
  }
}
