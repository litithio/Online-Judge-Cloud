---
# Feste Schrift: mermaid bemisst die Kästen mit der Schrift, die beim
# Rendern verfügbar ist. Weicht die Anzeigeschrift ab, laufen Texte über
# die Ränder.
config:
  # ELK schichtet die Gruppen strikt vertikal und führt Kanten orthogonal.
  # Das Standard-Layout (dagre) verstreute Server-VM und Werkzeuge um den
  # Cluster herum. ELK kann nur der eigene Renderer, nicht GitHub-Mermaid.
  layout: elk
  fontFamily: Arial, Helvetica, sans-serif
  # Größere Schrift, weil GitHub das Bild auf Spaltenbreite skaliert und
  # die Kästen mit der Schrift wachsen, die Abstände nicht.
  themeVariables:
    fontSize: 22px
---
flowchart TB
    studierende["🧑‍🎓 Studierende, Browser"]
    subgraph werkzeuge["🧰 Provisionierung, läuft von außen"]
        tf["🛠️ Terraform"]
        ansible["🛠️ Ansible,<br/>k3s-dhbw-cloud-role"]
        ci["⚙️ GitHub Actions<br/>baut Images"]
    end

    subgraph openstack["☁️ OpenStack, Netz DHBWV6,<br/>Security Group judge-k3s-nodes"]
        traefik["🚪 Traefik, TLS und OIDC-Plugin<br/>Server oder Dienste-Node"]
        subgraph server["🖥️ Server-VM, 2 vCPU, 4 GB"]
            cp["k3s Control Plane"]
        end
        subgraph dienste["🖥️ 3 Dienste-VMs, je 4 vCPU, 8 GB<br/>Label online-judge/rolle=dienste"]
            app["Anwendung, siehe unten<br/>API, Keycloak, PostgreSQL,<br/>MongoDB, Valkey, KEDA"]
            monitoring["📈 Prometheus und Grafana"]
            rolle["aus der k3s-Rolle<br/>cert-manager, ExternalDNS,<br/>system-upgrade-controller,<br/>💾 Longhorn"]
        end
        subgraph judgenodes["🖥️ 2 Judge-VMs, je 4 vCPU, 8 GB"]
            judge["⚖️ Judge-Worker<br/>RuntimeClass gvisor,<br/>Taint online-judge/sandbox=runsc,<br/>Sandbox je Testlauf"]
        end
    end

    subgraph umgebung["🌍 Externe Dienste"]
        dns["🌐 DNS-Zone<br/>judge.&lt;kennung&gt;.users.dhbw.site"]
        ca["🔏 ACME-CA der DHBW<br/>certificates.dhbw.cloud"]
        ghcr["📦 ghcr.io<br/>Container-Images"]
    end

    studierende ==>|"HTTPS über IPv6"| traefik
    traefik ==>|"geprüfte Anfragen"| app
    traefik -.->|"Grafana"| monitoring
    monitoring -.->|"Metriken"| app
    judge ==>|"Warteschlange, Aufgaben, Urteile"| app
    tf -.->|"legt VMs an"| openstack
    ansible -.->|"installiert"| cp
    ci -.->|"pusht nach"| ghcr
    dienste -.->|"Image-Pull"| ghcr
    judgenodes -.->|"Image-Pull"| ghcr
    app -.->|"PVCs"| rolle
    rolle -.->|"Einträge"| dns
    rolle -.->|"Zertifikat"| ca

    classDef extern fill:#eceff4,stroke:#7b8794,color:#1f2933
    classDef werkzeug fill:#eceff4,stroke:#7b8794,color:#1f2933,stroke-dasharray:4 3
    classDef plattform fill:#ede7f6,stroke:#7e57c2,color:#311b92
    classDef anwendung fill:#e6f4ea,stroke:#34a853,color:#0d652d

    class dns,ca,ghcr,studierende extern
    class tf,ansible,ci werkzeug
    class cp,traefik,rolle,monitoring plattform
    class app,judge anwendung

    style werkzeuge fill:#f4f5f7,stroke:#9aa4b2,color:#2f3a48
    style umgebung fill:#f4f5f7,stroke:#9aa4b2,color:#2f3a48
    style openstack fill:#f0f6ff,stroke:#5b8def,color:#1b3a6b
    style server fill:#fafbfd,stroke:#93a4bd,color:#3a4a5d
    style dienste fill:#fafbfd,stroke:#93a4bd,color:#3a4a5d
    style judgenodes fill:#fafbfd,stroke:#93a4bd,color:#3a4a5d
